[Desktop Entry]
Type=Application
Version=1.5
Name=xd-art
GenericName=Pixel Art Converter
Comment=Turn images into pixel art
Exec=xd-art %F
Icon=xd-art
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/bmp;image/x-tga;image/x-qoi;image/gif;
Keywords=pixel;dither;palette;sprite;
Actions=convert;

[Desktop Action convert]
Name=Convert to pixel art next to the file
Exec=xd-art-cli batch --next-to-input %F
